<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 is the fleet floor (CodeCarver, CodeCompass.Core) so any SDK >= 8 (incl. the work box's 9)
         builds from source; the self-contained AOT exe still ships with no runtime needed. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codespawner</AssemblyName>
    <RootNamespace>CodeSpawner</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- Native AOT: single self-contained native exe, no runtime on target machines. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Deterministic text output; we never rely on culture-specific formatting. -->
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <!-- Keep the AOT exe lean; we do our own JSON so no reflection metadata needed. -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>

</Project>
