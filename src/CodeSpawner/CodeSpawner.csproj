<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 is the fleet floor (CodeCarver, CodeCompass.Core) so any SDK >= 8 (incl. the work box's 9)
         builds from source; the self-contained AOT exe still ships with no runtime needed. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codespawner</AssemblyName>
    <RootNamespace>CodeSpawner</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- Native AOT: single self-contained native exe, no runtime on target machines. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Deterministic text output; we never rely on culture-specific formatting. -->
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <!-- Keep the AOT exe lean; we do our own JSON so no reflection metadata needed. -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <!-- One source of truth for the version: Program.Version (bumped by release.ps1). Stamp it into the PE
         FileVersion/ProductVersion too, so Explorer and file-version checks don't report 1.0.0.0. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Program.cs')), 'const string Version = "([0-9.]+)"').Groups[1].Value)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeSpawner.Tests" />
  </ItemGroup>

</Project>
